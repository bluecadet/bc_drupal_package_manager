{
  "name": "bluecadet/bc_drupal_package_manager",
  "description": "Adds functionality to check for updates for custom Drupal modules built by Bluecadet.",
  "authors": [
    {
      "name": "Pete Inge",
      "email": "pete.inge@gmail.com",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/bluecadet/bc_drupal_package_manager/issues"
  },
  "license": "GPL-2.0-or-later",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "drupal/core": "^10.1 || ^11",
    "z4kn4fein/php-semver": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "Bluecadet\\DrupalPackageManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bluecadet\\DrupalPackageManager\\Tests\\": "tests/src/",
      "Drupal\\update\\": "vendor/drupal/core/modules/update/src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": false,
      "drupal/core-composer-scaffold": false
    }
  }
}
